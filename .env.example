# PostgreSQL connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shipments

# API
PORT=3000

# Detection scan schedule (cron syntax). Default: every 15 minutes
SCAN_CRON=*/15 * * * *

# Where alerts go: "console" (default) or "sns"
ALERT_PUBLISHER=console
AWS_REGION=us-west-2
SNS_TOPIC_ARN=

# Priority customers get stricter time thresholds (0.75 = 25% tighter)
PRIORITY_THRESHOLD_FACTOR=0.75
